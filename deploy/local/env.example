# deploy/local/.env のひな形。このファイルをコピーして .env を作成する。
# cp deploy/local/env.example deploy/local/.env

OPENAI_API_KEY=sk-...

# 任意: Azure OpenAI 等
# OPENAI_BASE_URL=https://...

# 任意: ホスト側から Postgres に接続するときの公開ポート
# POSTGRES_PUBLISH_PORT=5433

POSTGRES_USER=llamastack
POSTGRES_PASSWORD=llamastack
POSTGRES_DB=llamastack

LLAMA_STACK_PORT=8321

# 任意: Qdrant の REST をホストから見るときの公開ポート（Compose のマッピング）
# QDRANT_PUBLISH_PORT=6333

# 任意: Qdrant に API キーを付ける場合（未使用なら空のまま）
# QDRANT_API_KEY=

# dogen-api（Quarkus）の HTTP ポート
CHAT_API_PORT=8081

# 静的サイト（nginx コンテナ dogen-web）のホスト側ポート
# WEB_PUBLISH_PORT=8080

# Keycloak（ログイン / アカウント管理）
# KEYCLOAK_PUBLISH_PORT=8180
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# OpenShift の 00-project-and-secrets.sh では KEYCLOAK_* も dogen-secrets に入ります
# Keycloak がリンク生成に使う公開 URL（上の publish port に合わせる）
# KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8180

# チャット既定モデル（OpenAI / Llama Stack のモデル ID）
# Llama Stack: 多くの場合は provider/ 接頭辞（OpenAI 経由なら openai/gpt-4o-mini 等）。一覧: GET {LLAMA}/v1/models
DOGEN_CHAT_DEFAULT_MODEL=openai/gpt-4o-mini

# dogen-api CORS: application.yaml %compose uses origins /.*/ by default. Override with Quarkus env if needed:
# QUARKUS_HTTP_CORS_ORIGINS=https://your-app.example.com

# dogen-api: Web 検索（Tavily）。キーが空だと起動検証に失敗するため、使うときだけ設定
# DOGEN_CHAT_WEB_SEARCH_API_KEY=tvly-...
# DOGEN_CHAT_WEB_SEARCH_ENABLED=true
# BRAVE_SEARCH_API_KEY=

# ---- OIDC（ユーザ識別子 sub を chat_session.client_subject に保存）----
# 既定の compose.yaml は Keycloak を同梱し、API 側は QUARKUS_PROFILE=compose,oidc を既定にしている。
# 無効化（匿名運用）したい場合は QUARKUS_PROFILE=compose のみにする。
#
# QUARKUS_PROFILE=compose,oidc
# OIDC_AUTH_SERVER_URL=http://keycloak:8080/realms/dogen
#
# 静的サイト（web/）の OIDC ログイン: IdP にリダイレクト URI として次を登録（オリジンは環境に合わせる）
#   http://127.0.0.1:8080/auth/callback.html
# 設定は web/js/oidc-config.js（authority / client_id / enabled）。流れは web/auth/index.html を参照。

# 任意: API イメージ名（既定 localhost/dogen-api:latest）
# DOGEN_API_IMAGE=localhost/dogen-api:latest

# ---- DB バックアップ（deploy/local/scripts/postgres-backup.sh）----
# BACKUP_DIR=/path/to/backups
# RETENTION_DAYS=7
# POSTGRES_CONTAINER=dogen-postgres
